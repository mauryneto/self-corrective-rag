# Copy to .env and adjust. Never commit .env.

# Postgres + pgvector (docker compose exposes it on 5433 to avoid clashing with a local Postgres).
# 127.0.0.1, not localhost: on Windows, localhost may try IPv6 first and hang.
DATABASE_URL=postgresql://rag:rag@127.0.0.1:5433/rag

# Embeddings run locally through Ollama (bge-m3, 1024 dims, multilingual)
OLLAMA_URL=http://127.0.0.1:11434
EMBED_MODEL=bge-m3

# LLM used to generate answers: "ollama" (local, free) or "anthropic" (Claude API)
LLM_PROVIDER=ollama
OLLAMA_LLM_MODEL=qwen2.5:14b
# Layers of the local model on the GPU. Pin it so every run uses the same arithmetic, and keep it low
# enough that the embedding model stays loaded too (otherwise each question swaps models). 16 fits
# qwen2.5:14b + bge-m3 in 8 GB of VRAM. Leave unset to let Ollama decide (runs are then not comparable).
OLLAMA_NUM_GPU=16
# For qwen2.5:7b, which fits whole in 8 GB: OLLAMA_LLM_MODEL=qwen2.5:7b, OLLAMA_NUM_GPU=99 and
# EMBED_NUM_GPU=0 (embedding model on the CPU, so the 7B and V4's reranker share the card without swapping).
# EMBED_NUM_GPU=0
# Passage cut for V3/V4, an experiment that gave no gain (README, "Fewer passages for the 7B"). Off when unset.
# PASSAGE_MIN_SCORE=0.5
# PASSAGE_MAX=3
ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=sk-ant-...

# Retrieval
TOP_K=6
