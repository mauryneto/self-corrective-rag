# Copy to .env and adjust. Never commit .env.

# Postgres + pgvector (docker compose exposes it on 5433 to avoid clashing with a local Postgres).
# 127.0.0.1, not localhost: on Windows, localhost may try IPv6 first and hang.
DATABASE_URL=postgresql://rag:rag@127.0.0.1:5433/rag

# Embeddings run locally through Ollama (bge-m3, 1024 dims, multilingual)
OLLAMA_URL=http://127.0.0.1:11434
EMBED_MODEL=bge-m3

# LLM used to generate answers: "ollama" (local, free) or "anthropic" (Claude API)
LLM_PROVIDER=ollama
OLLAMA_LLM_MODEL=qwen2.5:14b
ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=sk-ant-...

# Retrieval
TOP_K=6
